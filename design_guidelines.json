  "instructions_to_main_agent": {
    "setup_steps": [
      "1. Install Leaflet: `cd /app/frontend && yarn add leaflet @types/leaflet`",
      "2. Ensure Leaflet CSS is imported in `index.html` or `App.tsx` (`import 'leaflet/dist/leaflet.css';`)",
      "3. Configure custom Leaflet DivIcon markers with SVG category icons and status indicator dots to avoid broken asset icon issues."
    ],
    "key_components": [
      {
        "name": "LocalitySelector",
        "path": "@/components/LocalitySelector.tsx",
        "description": "State -> District -> Town -> Locality cascading picker with GPS 'Detect My Locality' and search. Persisted to localStorage & synced across the app."
      },
      {
        "name": "InteractiveMapView",
        "path": "@/components/InteractiveMapView.tsx",
        "description": "Full Leaflet map supporting mode: 'browse' (category markers, popups, cluster/filter) and mode: 'select_location' (draggable pin + search + GPS)."
      },
      {
        "name": "StatusTimeline",
        "path": "@/components/StatusTimeline.tsx",
        "description": "Vertical civic tracking timeline for complaints (Reported -> Under Review -> Assigned -> In Progress -> Resolved/Rejected) with admin remarks and timestamps."
      },
      {
        "name": "UpvoteButton",
        "path": "@/components/UpvoteButton.tsx",
        "description": "One-click civic upvote button with live count, optimistic UI update, and auth prompt if unauthenticated."
      },
      {
        "name": "AdminStatusModal",
        "path": "@/components/AdminStatusModal.tsx",
        "description": "Allows municipal officers / admins to change complaint status, assign department, and add official resolution remarks or upload resolution proof."
      }
    ],
