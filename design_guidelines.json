      "electricity": "#CA8A04",
      "public_safety": "#DC2626",
      "other_infrastructure": "#4B5563"
    }
  },
  "typography": {
    "font_family_heading": "Manrope, sans-serif",
    "font_family_body": "Inter, sans-serif",
    "css_import": "@import \"@fontsource-variable/manrope\";\n@import \"@fontsource-variable/inter\";",
    "scale_px": {
      "display": 52,
      "h1": 40,
      "h2": 32,
      "h3": 24,
      "h4": 20,
      "body": 16,
      "caption": 14
    },
    "rules": {
      "headings": "font-heading font-bold tracking-tight text-[#172B3A]",
      "subheadings": "font-sans text-base text-[#52656F] leading-relaxed",
      "overlines": "text-xs font-semibold tracking-wider uppercase text-[#237A62]"
    }
  },
  "entry_surfaces": {
    "/": "split hero — brand identity & quick locality issue summary left with submit CTA, interactive live Leaflet issue feed right",
    "/login": "branded split login — citizen impact overview left, secure email/password form with test credentials right",
    "/register": "branded split register — civic duty & onboarding guide left, registration form right",
    "/report": "focused multi-step submission flow with interactive pin placement and photo upload",
    "/admin": "dense functional command dashboard with KPI stats bar, locality filter dropdowns, issues management data table and analytics",
    "/complaints/:id": "detailed split view with complaint metadata, real map pin, evidence photo gallery, upvote button, and official status timeline"
  },
  "layouts": {
    "header": {
      "height": "h-16",
      "style": "sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#E2E4DC] px-4 md:px-8 flex items-center justify-between"
    },
    "locality_bar": {
      "style": "bg-[#EAECE4] border-b border-[#D5D9CD] px-4 md:px-8 py-2.5 flex items-center justify-between gap-4 flex-wrap text-sm"
    },
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8",
    "grid_modes": {
      "dashboard_kpis": "grid grid-cols-2 lg:grid-cols-4 gap-4",
      "complaints_grid": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6",
      "split_map_view": "grid grid-cols-1 lg:grid-cols-12 gap-6 min-h-[640px]"
    }
  },
  "motion": {
    "principles": "Subtle, functional transitions only. Avoid slow animations or bouncy decorations.",
    "hover_transition": "transition-colors duration-150 ease-out",
    "card_hover": "hover:border-[#CBD5E1] hover:shadow-sm transition-all duration-150",
    "button_active": "active:scale-[0.98] transition-transform duration-75",
    "toast_duration_ms": 3000
  },
  "accessibility": {
    "contrast_standard": "WCAG AA (minimum 4.5:1 for body and captions)",
    "focus_rings": "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#237A62] focus-visible:ring-offset-2",
    "reduced_motion": "motion-reduce:transition-none motion-reduce:animate-none",
    "data_testid_policy": "All interactive buttons, inputs, dropdowns, filters, cards, and modal triggers must have descriptive kebab-case data-testid attributes"
  },
